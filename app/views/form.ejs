<%- include('header') %><section class="editor"><a href="/admin/<%= entity %>">← Quay lại danh sách</a><h1><%= row.id ? 'Chỉnh sửa' : 'Thêm mới' %> · <%= config.label %></h1><form method="post" action="/admin/<%= entity %>/<%= row.id || 'new' %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% config.columns.forEach(c=> { %><label><%= ({title:'Tiêu đề',body:'Nội dung',name:'Tên',description:'Mô tả',email:'Email',role:'Vai trò',status:'Trạng thái',category_id:'Danh mục',author_id:'Tác giả'})[c] %>
<% if(c==='body' || c==='description') { %><textarea name="<%= c %>" rows="<%= c==='body'?14:3 %>" required maxlength="<%= c==='body'?50000:1000 %>"><%= row[c] || '' %></textarea>
<% } else if(c==='category_id' || c==='author_id') { %><select name="<%= c %>" required><% (c==='category_id'?categories:users).forEach(o=> { %><option value="<%= o.id %>" <%= row[c]===o.id?'selected':'' %>><%= o.name %></option><% }) %></select>
<% } else if(c==='role' || c==='status') { %><select name="<%= c %>"><% (c==='role'?['reader','admin']:['draft','published']).forEach(o=> { %><option value="<%= o %>" <%= row[c]===o?'selected':'' %>><%= o %></option><% }) %></select>
<% } else { %><input name="<%= c %>" type="<%= c==='email'?'email':'text' %>" value="<%= row[c] || '' %>" maxlength="<%= c==='title'?200:c==='email'?255:100 %>" required><% } %></label><% }) %>
<% if(entity==='users') { %><label>Mật khẩu <%= row.id?'(để trống để giữ nguyên)':'' %><input name="password" type="password" autocomplete="new-password" minlength="16" maxlength="72" <%= row.id?'':'required' %>></label><% } %><button class="primary">Lưu thay đổi</button></form></section><%- include('footer') %>
